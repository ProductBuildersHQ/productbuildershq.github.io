---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import catalog from '../../../data/sdd-catalog.json'

export async function getStaticPaths() {
  return catalog.integrations.map((tool) => ({ params: { id: tool.id }, props: { tool } }))
}

const { tool } = Astro.props

const specName = (id: string) => catalog.spec_types.find((s) => s.id === id)?.shortName ?? id
const feedingPipelines = catalog.pipelines.filter((p) => p.execution.integration === tool.id)
const links = [
  tool.repo && { label: 'Repository', href: tool.repo },
  tool.reference && tool.reference !== tool.repo && { label: 'Documentation', href: tool.reference },
  tool.homepage && tool.homepage !== tool.repo && { label: 'Homepage', href: tool.homepage },
].filter(Boolean) as { label: string; href: string }[]
---

<BaseLayout title={`${tool.name} — Execution Workflow`} description={tool.description ?? tool.name}>
  <div class="py-8 md:py-12">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <a href="/sdd/#execution" class="inline-flex items-center text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] no-underline mb-6">
        <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
        SDD Catalog
      </a>

      <div class="mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="text-xs font-medium px-2.5 py-1 bg-[var(--color-accent)] text-[var(--color-primary-dark)] rounded-full">Execution Workflow</span>
          <span class="text-xs text-[var(--color-text-subtle)]">{tool.vendor}</span>
          {tool.license && <span class="text-xs px-2 py-1 bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] rounded">{tool.license}</span>}
        </div>
        <h1 class="text-3xl md:text-4xl font-bold mb-3">{tool.name}</h1>
        <p class="text-lg text-[var(--color-text-muted)] max-w-3xl">{tool.description}</p>
        {tool.source === 'docs' && (
          <p class="text-sm text-[var(--color-text-muted)] mt-3 italic">Modeled from published documentation (no inspectable source repository); on-disk detail is lower-confidence than repo-modeled tools.</p>
        )}
        {links.length > 0 && (
          <div class="flex flex-wrap gap-3 mt-5">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 border border-[var(--color-border)] text-[var(--color-text)] text-sm font-medium rounded-lg no-underline hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-primary)] transition-colors">
                {l.label}
                <svg class="w-3.5 h-3.5 text-[var(--color-text-subtle)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>

      <section class="mb-12 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl">
          <h2 class="text-sm font-semibold tracking-wide uppercase text-[var(--color-text-subtle)] mb-3">Detection</h2>
          <p class="text-sm text-[var(--color-text-muted)] mb-3">A project uses {tool.short_name ?? tool.name} when any of these exist:</p>
          <ul class="space-y-1.5">
            {(tool.detection.root_markers ?? []).concat(tool.detection.globs ?? []).map((m) => (
              <li class="font-mono text-sm text-[var(--color-text)]">{m}</li>
            ))}
          </ul>
        </div>
        <div class="p-5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl">
          <h2 class="text-sm font-semibold tracking-wide uppercase text-[var(--color-text-subtle)] mb-3">Status Model</h2>
          {tool.status ? (
            <>
              <p class="text-sm font-medium text-[var(--color-text)] mb-2">Method: <span class="font-mono">{tool.status.method}</span></p>
              <p class="text-sm text-[var(--color-text-muted)]">{tool.status.description}</p>
            </>
          ) : (
            <p class="text-sm text-[var(--color-text-muted)]">No status model declared.</p>
          )}
        </div>
      </section>

      {tool.lifecycle && tool.lifecycle.length > 0 && (
        <section class="mb-12">
          <h2 class="text-xl font-semibold mb-4">Lifecycle</h2>
          <ol class="grid grid-cols-1 gap-3">
            {tool.lifecycle.map((phase, i) => (
              <li class="flex items-start gap-4 p-4 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-lg">
                <span class="shrink-0 w-7 h-7 inline-flex items-center justify-center rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-semibold">{i + 1}</span>
                <div>
                  <div class="flex flex-wrap items-baseline gap-2">
                    <span class="text-sm font-semibold text-[var(--color-text)]">{phase.name}</span>
                    {phase.command && <span class="font-mono text-xs px-1.5 py-0.5 bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] rounded">{phase.command}</span>}
                  </div>
                  {phase.description && <p class="text-sm text-[var(--color-text-muted)] mt-1">{phase.description}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      {tool.artifacts && tool.artifacts.length > 0 && (
        <section class="mb-12">
          <h2 class="text-xl font-semibold mb-4">On-Disk Artifacts</h2>
          <div class="grid grid-cols-1 gap-2">
            {tool.artifacts.map((a) => (
              <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4 p-3.5 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-lg">
                <span class="font-mono text-xs text-[var(--color-text)] shrink-0 sm:w-80 break-all">{a.path}</span>
                <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] rounded-full shrink-0">{a.role}</span>
                <span class="text-sm text-[var(--color-text-muted)]">
                  {a.description}
                  {a.spec_type && <> Maps to <a href={`/sdd/specs/${a.spec_type}`} class="text-[var(--color-primary)] no-underline hover:underline">{specName(a.spec_type)}</a>.</>}
                </span>
              </div>
            ))}
          </div>
        </section>
      )}

      {feedingPipelines.length > 0 && (
        <section class="mb-6">
          <h2 class="text-xl font-semibold mb-4">Fed by Definition Workflows</h2>
          <div class="grid grid-cols-1 gap-3">
            {feedingPipelines.map((p) => (
              <a href={`/sdd/definition/${p.definition.workflow}`} class="group block p-4 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-lg no-underline hover:border-[var(--color-primary)] transition-all">
                <span class="text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-primary)]">{p.name}</span>
                <span class="block text-sm text-[var(--color-text-muted)] mt-1">{p.description}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

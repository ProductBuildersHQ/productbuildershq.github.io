---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const signals = await getCollection('signals')
  return signals.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const allFrameworks = await getCollection('frameworks')
const relatedFrameworks = (entry.data.frameworks ?? [])
  .map((id) => allFrameworks.find((framework) => framework.id === id))
  .filter((framework) => framework !== undefined)
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="py-8 md:py-12">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <a href="/signals" class="no-print inline-flex items-center text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] no-underline mb-6">
        <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Signals
      </a>

      <div class="mb-8">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="text-sm font-medium px-3 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded-full">Signal</span>
          <span class="text-sm text-[var(--color-text-subtle)]">{entry.data.author}{entry.data.authorRole && ` — ${entry.data.authorRole}`} &middot; {entry.data.date}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold mb-2">{entry.data.title}</h1>
        {entry.data.subtitle && <p class="text-xl text-[var(--color-primary)] mb-4">{entry.data.subtitle}</p>}
        <p class="text-[var(--color-text-muted)] mb-6 max-w-3xl">{entry.data.description}</p>
        <div class="no-print flex flex-wrap gap-3">
          {entry.data.sources.map((source) => (
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--color-border)] text-[var(--color-text)] font-medium rounded-lg no-underline hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-primary)] transition-colors">
              {source.label}
              <svg class="w-4 h-4 text-[var(--color-text-subtle)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mb-8">
        {entry.data.tags.map((tag) => (
          <span class="text-sm px-3 py-1 bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] rounded-full">{tag}</span>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-10">
        <aside class="hidden lg:block">
          <div class="sticky top-24 border-l border-[var(--color-border-light)] pl-4">
            <div class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-subtle)] mb-3">Contents</div>
            <nav class="space-y-2">
              {headings.filter((heading) => heading.depth === 2).map((heading) => (
                <a href={`#${heading.slug}`} class="block text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] no-underline">{heading.text}</a>
              ))}
            </nav>
            {relatedFrameworks.length > 0 && (
              <div class="mt-8">
                <div class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-subtle)] mb-3">Related Frameworks</div>
                <nav class="space-y-2">
                  {relatedFrameworks.map((framework) => (
                    <a href={`/frameworks/${framework.id}`} class="block text-sm text-[var(--color-primary)] hover:underline no-underline">{framework.data.title}</a>
                  ))}
                </nav>
              </div>
            )}
          </div>
        </aside>
        <article class="article-content min-w-0">
          <Content />
        </article>
      </div>
    </div>
  </div>
</BaseLayout>

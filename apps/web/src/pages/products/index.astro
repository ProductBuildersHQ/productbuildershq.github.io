---
import BaseLayout from '../../layouts/BaseLayout.astro'
import suite from '../../data/app.json'

const local = [
  { name: 'VisionStudio', href: '/products/visionstudio', text: 'The local app for authoring, judging and tracking specs and roadmaps.' },
  { name: 'VisionSpec', href: '/products/visionspec', text: 'Multi-domain specification orchestration.' },
  { name: 'SCALE', href: '/products/scale', text: 'Standards, Consumption, Automation, Leverage, Effectiveness.' },
]
const card = 'block p-6 bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl no-underline hover:border-[var(--color-primary)] hover:shadow-lg transition-all'
---

<BaseLayout title="Products" description={`${suite.name}: ${suite.summary}`}>
  <div class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Products</h1>
      <p class="text-xl text-[var(--color-text-muted)] max-w-3xl mb-14">
        What we build to help you build: the {suite.name} app, the local and open-source tools
        behind it, and free tools you can use in the browser.
      </p>

      <section aria-labelledby="app">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <h2 id="app" class="text-2xl font-bold">The {suite.name} app</h2>
          <span class="text-xs font-medium px-2 py-1 bg-[var(--color-accent)] text-[var(--color-primary-dark)] rounded">Invite-only</span>
        </div>
        <p class="text-[var(--color-text-muted)] max-w-3xl mb-6">{suite.summary}</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {suite.apps.map((a) => (
            <a href={`/products/${a.id}`} class={card}>
              <div class="text-xl font-bold text-[var(--color-text)]">{a.name}</div>
              <div class="text-sm font-medium text-[var(--color-primary)] mt-1">&ldquo;{a.question}&rdquo;</div>
              <p class="text-sm text-[var(--color-text-muted)] mt-3 mb-0">{a.summary}</p>
            </a>
          ))}
        </div>
        <div class="flex flex-col sm:flex-row flex-wrap gap-4 mt-6">
          <a href={suite.signInUrl} class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-primary-dark)] text-white font-medium rounded-lg no-underline hover:bg-[var(--color-primary)] transition-colors">Sign in</a>
          <a href={suite.waitlistUrl} class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-accent)] text-[var(--color-primary-dark)] font-medium rounded-lg no-underline hover:bg-[var(--color-accent-light)] transition-colors">Join the waitlist</a>
          <a href="/integrations" class="inline-flex items-center justify-center px-6 py-3 border border-[var(--color-border)] text-[var(--color-text)] font-medium rounded-lg no-underline hover:border-[var(--color-primary)] transition-colors">Integrations</a>
          <a href="/pricing" class="inline-flex items-center justify-center px-6 py-3 border border-[var(--color-border)] text-[var(--color-text)] font-medium rounded-lg no-underline hover:border-[var(--color-primary)] transition-colors">Pricing</a>
        </div>
      </section>

      <section aria-labelledby="local" class="mt-16">
        <h2 id="local" class="text-2xl font-bold mb-6">Local and open source</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {local.map((p) => (
            <a href={p.href} class={card}>
              <div class="text-xl font-bold text-[var(--color-text)]">{p.name}</div>
              <p class="text-sm text-[var(--color-text-muted)] mt-2 mb-0">{p.text}</p>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="free" class="mt-16">
        <h2 id="free" class="text-2xl font-bold mb-6">Free tools and the showcase</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a href="/tools" class={card}>
            <div class="text-xl font-bold text-[var(--color-text)]">Tools</div>
            <p class="text-sm text-[var(--color-text-muted)] mt-2 mb-0">Free tools for builders that run in your browser.</p>
          </a>
          <a href="/showcase" class={card}>
            <div class="text-xl font-bold text-[var(--color-text)]">Showcase</div>
            <p class="text-sm text-[var(--color-text-muted)] mt-2 mb-0">Live sites we build and run with {suite.name}.</p>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

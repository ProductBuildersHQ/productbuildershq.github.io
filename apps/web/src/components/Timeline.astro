---
// Generic horizontal/vertical event timeline: an SVG connector line threading
// through a row (desktop) or column (mobile) of clickable event cards. Kept
// framework-agnostic (plain props, no content-collection imports) so it can
// be lifted into a standalone package later without rework — see
// github.com/grokify/web-tools/packages/site-nav for the precedent of
// promoting a site-local component once a second consumer needs it.
export interface TimelineEvent {
  date: string // ISO yyyy-mm-dd
  title: string
  subtitle?: string
  href: string
}

interface Props {
  events: TimelineEvent[]
  ariaLabel?: string
}

const { events, ariaLabel = 'Timeline' } = Astro.props as Props

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  })

const columns = Math.max(events.length, 1)
const halfColumn = 50 / columns
---

<div class="pbhq-timeline">
  <svg
    class="pbhq-timeline-track pbhq-timeline-track--row"
    style={`left: ${halfColumn}%; right: ${halfColumn}%;`}
    viewBox="0 0 2 2"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <line x1="0" y1="1" x2="2" y2="1" vector-effect="non-scaling-stroke"></line>
  </svg>
  <svg class="pbhq-timeline-track pbhq-timeline-track--col" viewBox="0 0 2 2" preserveAspectRatio="none" aria-hidden="true">
    <line x1="1" y1="0" x2="1" y2="2" vector-effect="non-scaling-stroke"></line>
  </svg>

  <ol class="pbhq-timeline-row" style={`grid-template-columns: repeat(${columns}, 1fr);`} aria-label={ariaLabel}>
    {events.map((event) => (
      <li class="pbhq-timeline-item">
        <a href={event.href} class="pbhq-timeline-event">
          <svg class="pbhq-timeline-dot" viewBox="0 0 18 18" aria-hidden="true">
            <circle cx="9" cy="9" r="6.5"></circle>
          </svg>
          <span class="pbhq-timeline-card">
            <span class="pbhq-timeline-meta">
              <span class="pbhq-timeline-title">{event.title}</span>
              <span class="pbhq-timeline-date">{formatDate(event.date)}</span>
            </span>
            {event.subtitle && <span class="pbhq-timeline-subtitle">{event.subtitle}</span>}
          </span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .pbhq-timeline {
    position: relative;
  }

  .pbhq-timeline-track {
    position: absolute;
    stroke: var(--color-border);
    stroke-width: 2;
    fill: none;
    pointer-events: none;
  }

  .pbhq-timeline-track--row {
    display: none;
    top: 9px;
    height: 2px;
    width: auto;
  }

  .pbhq-timeline-track--col {
    top: 9px;
    bottom: 9px;
    left: 9px;
    width: 2px;
    height: auto;
  }

  .pbhq-timeline-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pbhq-timeline-item {
    display: contents;
  }

  .pbhq-timeline-event {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .pbhq-timeline-dot {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 0.7rem;
  }

  .pbhq-timeline-dot circle {
    fill: var(--color-bg-card);
    stroke: var(--color-primary);
    stroke-width: 2.5;
    transition: fill 0.15s ease, stroke 0.15s ease;
  }

  .pbhq-timeline-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.875rem 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .pbhq-timeline-event:hover .pbhq-timeline-card,
  .pbhq-timeline-event:focus-visible .pbhq-timeline-card {
    border-color: var(--color-primary);
    box-shadow: 0 4px 14px rgba(4, 120, 87, 0.12);
  }

  .pbhq-timeline-event:hover .pbhq-timeline-dot circle,
  .pbhq-timeline-event:focus-visible .pbhq-timeline-dot circle {
    fill: var(--color-primary);
  }

  .pbhq-timeline-event:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 0.75rem;
  }

  .pbhq-timeline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .pbhq-timeline-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .pbhq-timeline-event:hover .pbhq-timeline-title,
  .pbhq-timeline-event:focus-visible .pbhq-timeline-title {
    color: var(--color-primary);
  }

  .pbhq-timeline-date {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .pbhq-timeline-subtitle {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .pbhq-timeline-track--row {
      display: block;
    }

    .pbhq-timeline-track--col {
      display: none;
    }

    .pbhq-timeline-row {
      gap: 1.25rem;
      align-items: start;
    }

    .pbhq-timeline-event {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .pbhq-timeline-dot {
      margin-top: 0;
    }

    .pbhq-timeline-card {
      width: 100%;
    }
  }
</style>

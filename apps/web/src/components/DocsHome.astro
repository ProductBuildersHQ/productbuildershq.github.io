---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { docSections, plannedDocs, statusClasses, statusLabels } from '../lib/docs'

const all = (await getCollection('docs')).filter((d) => !(import.meta.env.PROD && d.data.draft))
const groups = docSections.map((section) => ({
  ...section,
  pages: all
    .filter((d) => d.data.section === section.id)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
  planned: plannedDocs.filter((p) => p.section === section.id),
}))
---

<BaseLayout
  title="Documentation"
  description="How to connect your services to ProductBuildersHQ, what data you get from them, what you will not get, and how to read it."
>
  <div class="py-8 md:py-12">
    <div class="max-w-4xl mx-auto px-5 md:px-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">Documentation</h1>
      <p class="text-lg text-[var(--color-text-muted)] mb-10">
        How to connect your services to ProductBuildersHQ, what data you get from them, what you will not get, and how to read it.
        These pages describe PBHQ. For how Cloudflare, PostHog and the others work in general, we link to their own documentation.
      </p>

      {groups.map((group) => (
        <section class="mb-10">
          <h2 class="text-xl font-semibold mb-1">{group.title}</h2>
          <p class="text-sm text-[var(--color-text-muted)] mb-4">{group.blurb}</p>
          <ul class="space-y-2">
            {group.pages.map((page) => (
              <li class="flex flex-wrap items-center gap-2">
                <a href={`/docs/${page.id}`} class="font-medium text-[var(--color-primary)] hover:underline no-underline">{page.data.title}</a>
                <span class={`text-xs px-2 py-0.5 rounded-full ${statusClasses(page.data.status)}`}>{statusLabels[page.data.status]}</span>
                {page.data.draft && <span class="text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-800">Draft</span>}
              </li>
            ))}
            {group.planned.map((item) => (
              <li class="flex flex-wrap items-center gap-2 text-[var(--color-text-muted)]">
                <span>{item.title}</span>
                <span class={`text-xs px-2 py-0.5 rounded-full ${statusClasses(item.status)}`}>{statusLabels[item.status]}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro'

interface Props {
  title: string
  description: string
  storageKey: string
  githubUrl: string
  docsUrl: string
  height?: 'fixed' | 'min'
}

const { title, description, storageKey, githubUrl, docsUrl, height = 'fixed' } = Astro.props
---

<BaseLayout title={`${title} | Tools`} description={description}>
  <div class="tool-shell" data-theme="light" data-storage-key={storageKey} data-height={height}>
    <header class="tool-bar">
      <div class="flex items-center gap-3">
        <a href="/tools/" class="tool-link">&larr; Tools</a>
        <span class="font-semibold">{title}</span>
      </div>
      <div class="flex items-center gap-1">
        <button type="button" class="tool-link" id="tool-theme-toggle" title="Toggle theme">Dark mode</button>
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="tool-link">GitHub</a>
        <a href={docsUrl} target="_blank" rel="noopener noreferrer" class="tool-link">Docs</a>
      </div>
    </header>
    <div class="tool-body">
      <slot />
    </div>
  </div>
</BaseLayout>

<script>
  const shell = document.querySelector<HTMLElement>('.tool-shell')
  const toggle = document.getElementById('tool-theme-toggle')
  const key = shell?.dataset.storageKey ?? 'tool'

  function setTheme(theme: 'light' | 'dark') {
    if (!shell) return
    shell.dataset.theme = theme
    shell.querySelectorAll('.tool-body > #tool').forEach((el) => el.setAttribute('theme', theme))
    if (toggle) toggle.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode'
    try {
      localStorage.setItem(`${key}-theme`, theme)
    } catch {
      // Storage can be blocked (private mode); the theme just won't persist.
    }
  }

  let saved: string | null = null
  try {
    saved = localStorage.getItem(`${key}-theme`)
  } catch {
    // See above.
  }
  setTheme(saved === 'dark' ? 'dark' : 'light')
  toggle?.addEventListener('click', () => setTheme(shell?.dataset.theme === 'dark' ? 'light' : 'dark'))
</script>

<style is:global>
  .tool-shell {
    --tool-bg: #ffffff;
    --tool-bg-2: #f8fdf9;
    --tool-bg-3: #f1f5f9;
    --tool-border: #d1d5db;
    --tool-text: #111827;
    --tool-text-2: #475569;
    --tool-text-muted: #94a3b8;
    --tool-accent: #047857;
    --tool-accent-hover: #065f46;
    color: var(--tool-text);
    background: var(--tool-bg);
  }
  .tool-shell[data-theme='dark'] {
    --tool-bg: #0f1f1a;
    --tool-bg-2: #162420;
    --tool-bg-3: #1e2e28;
    --tool-border: #2f4a41;
    --tool-text: #f1f5f9;
    --tool-text-2: #cbd5e1;
    --tool-text-muted: #64748b;
    --tool-accent: #34d399;
    --tool-accent-hover: #6ee7b7;
  }
  .tool-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.625rem 1.25rem;
    background: var(--tool-bg-2);
    border-bottom: 1px solid var(--tool-border);
  }
  .tool-link {
    color: var(--tool-text-2);
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.875rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    text-decoration: none;
  }
  .tool-link:hover {
    color: var(--tool-text);
    background: var(--tool-bg-3);
    text-decoration: none;
  }
  .tool-body {
    height: calc(100vh - 8.5rem);
    min-height: 32rem;
  }
  .tool-shell[data-height='min'] .tool-body {
    height: auto;
  }
  .tool-body > #tool {
    display: block;
    height: 100%;
    min-height: inherit;
  }
</style>

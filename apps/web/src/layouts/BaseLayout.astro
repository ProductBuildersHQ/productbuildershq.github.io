---
import '../styles/global.css'
import navConfig from '../config/nav-config.json'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'ProductBuildersHQ',
  description = 'Frameworks and case studies for the evolution of product development in the age of AI.',
} = Astro.props

const pageTitle = title === 'ProductBuildersHQ' ? title : `${title} | ProductBuildersHQ`
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const year = new Date().getFullYear()
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/'
  return normalized === '/' ? currentPath === '/' : currentPath.startsWith(normalized)
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      {/* Shared ProductBuildersHQ nav (wt-navbar web component) — the same
          component and /nav-config.json the MkDocs sub-sites use, so every
          property shares one navigation bar. */}
      <div class="sticky top-0 z-50">
        <div id="pbhq-navbar-container"></div>
        <noscript>
          <nav class="bg-[var(--color-frame-bg)]">
            <div class="max-w-7xl mx-auto px-5 md:px-8 flex items-center justify-between h-16">
              <a href="/" class="text-xl font-bold text-[var(--color-frame-text)] no-underline">{navConfig.brand.name}</a>
              <div class="flex items-center gap-6">
                {navConfig.links.map((link) => (
                  <a
                    href={link.href}
                    class:list={[
                      'text-sm font-medium no-underline',
                      isActive(link.href) ? 'text-[var(--color-frame-accent)]' : 'text-[var(--color-frame-text-muted)]',
                    ]}
                  >
                    {link.label}
                  </a>
                ))}
                <a href="/sdd/" class="text-sm font-medium text-[var(--color-frame-text-muted)] no-underline">SDD Catalog</a>
              </div>
            </div>
          </nav>
        </noscript>
      </div>
      <script is:inline src="/js/site-nav.min.js"></script>
      <script is:inline src="/js/pbhq-nav.js"></script>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="bg-[var(--color-frame-bg)] text-[var(--color-frame-text)] py-12">
        <div class="max-w-7xl mx-auto px-5 md:px-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
              <h3 class="text-lg font-bold mb-4">ProductBuildersHQ</h3>
              <p class="text-[var(--color-frame-text-muted)] text-sm">Frameworks and case studies for the evolution of product development.</p>
            </div>
            <div>
              <h4 class="text-sm font-semibold uppercase tracking-wider mb-4 text-[var(--color-frame-accent)]">Research</h4>
              <ul class="space-y-2">
                <li><a href="/frameworks" class="text-[var(--color-frame-text-muted)] hover:text-[var(--color-frame-text)] text-sm no-underline">Frameworks</a></li>
                <li><a href="/case-studies" class="text-[var(--color-frame-text-muted)] hover:text-[var(--color-frame-text)] text-sm no-underline">Case Studies</a></li>
                <li><a href="/perspectives" class="text-[var(--color-frame-text-muted)] hover:text-[var(--color-frame-text)] text-sm no-underline">Perspectives</a></li>
                <li><a href="/signals" class="text-[var(--color-frame-text-muted)] hover:text-[var(--color-frame-text)] text-sm no-underline">Signals</a></li>
                <li><a href="/sdd/" class="text-[var(--color-frame-text-muted)] hover:text-[var(--color-frame-text)] text-sm no-underline">SDD Catalog</a></li>
              </ul>
            </div>
            <div>
              <h4 class="text-sm font-semibold uppercase tracking-wider mb-4 text-[var(--color-frame-accent)]">Company</h4>
              <ul class="space-y-2">
                <li><a href="/about" class="text-[var(--color-frame-text-muted)] hover:text-[var(--color-frame-text)] text-sm no-underline">About</a></li>
                <li><a href="https://github.com/ProductBuildersHQ" target="_blank" rel="noopener noreferrer" class="text-[var(--color-frame-text-muted)] hover:text-[var(--color-frame-text)] text-sm no-underline">GitHub</a></li>
              </ul>
            </div>
          </div>
          <div class="mt-12 pt-8 border-t border-[var(--color-frame-border)] text-center text-[var(--color-frame-text-muted)] text-sm">
            <span class="text-[var(--color-frame-accent)]">ProductBuildersHQ.com</span>
            <span class="mx-2">&middot;</span>
            &copy; {year} ProductBuildersHQ
            <p class="mt-3 text-xs text-[var(--color-frame-text-muted)]/80 max-w-2xl mx-auto">
              Third-party frameworks, methodologies, tools, and marks referenced on this site belong
              to their respective owners. ProductBuildersHQ encodings and analyses are independent
              interpretations, not endorsements by their originators.
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
